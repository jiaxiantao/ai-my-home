generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Domain {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  strapline      String
  summary        String
  overview       String   @db.Text
  icon           String
  expertiseLevel String
  highlights     String[]
  principles     String[]
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  topics         Topic[]
}

model Topic {
  id           String   @id @default(cuid())
  domainId     String
  title        String
  summary      String
  bodyMarkdown String   @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  domain       Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model CaseStudy {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  context   String   @db.Text
  impact    String   @db.Text
  stack     String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusProbeHistory {
  id           String   @id @default(cuid())
  probeKey     String
  environment  String   @default("local")
  p50Ms        Int?
  p95Ms        Int?
  avgSteps     Float?
  avgToolCalls Float?
  errorRate    Float?
  ok           Boolean  @default(true)
  detail       String?
  createdAt    DateTime @default(now())

  @@index([probeKey, environment, createdAt])
  @@index([createdAt])
}

model IntelligenceProfile {
  id          String   @id @default(cuid())
  owner       String   @unique
  preferences Json
  learning    Json
  history     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReleaseApp {
  id           String         @id @default(cuid())
  name         String
  repo         String
  buildCommand String
  testCommand  String
  createdAt    DateTime       @default(now())
  orders       ReleaseOrder[]
}

model ReleaseOrder {
  id              String   @id @default(cuid())
  appId           String
  appName         String
  version         String
  branch          String
  changeTicket    String
  status          String   @default("draft")
  buildStatus     String   @default("pending")
  buildDurationMs Int?
  buildArtifact   String?
  buildLogs       String[] @default([])
  unitPassed      Boolean  @default(false)
  e2ePassed       Boolean  @default(false)
  securityPassed  Boolean  @default(false)
  approved        Boolean  @default(false)
  approver        String?
  approvalReason  String?
  approvedAt      DateTime?
  testStatus      String   @default("pending")
  testDeployedAt  DateTime?
  preStatus       String   @default("pending")
  preDeployedAt   DateTime?
  prodStatus      String   @default("pending")
  prodDeployedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  app             ReleaseApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  auditLogs       ReleaseAuditLog[]

  @@index([appId, createdAt])
  @@index([status])
}

model ReleaseAuditLog {
  id        String   @id @default(cuid())
  orderId   String
  operator  String
  action    String
  detail    String   @db.Text
  createdAt DateTime @default(now())
  order     ReleaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
